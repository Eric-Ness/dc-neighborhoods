{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "preview", "--", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "demos-static",
      "runtimeExecutable": "python",
