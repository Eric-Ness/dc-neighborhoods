---
import Base from "../layouts/Base.astro";
import { neighborhoods } from "../lib/data";
import { asOf, fmt, money } from "../lib/c5";
---
<Base title="DC Neighborhoods: civic data, block by block" description="Independent, automatically updated civic data for Washington, DC neighborhoods.">
  <main class="wrap" style="padding-top:28px">
    <div class="pagehead">
      <h1>DC Neighborhoods</h1>
      <p>Permits, 311 requests, home sales, curb space, street trees, history and who represents you, updated nightly from DC's own open data.</p>
    </div>
    <div class="row even">
      {neighborhoods.map((n) => (
        <a class="panel" href={`/${n.slug}/`} style="text-decoration:none;color:inherit">
          <div class="ph"><h2>{n.name}</h2><span class="sub" style="color:var(--accent);font-weight:600">Open →</span></div>
          <div class="stats s3">
            <div><div class="v">{n.permits.length}</div><div class="k">permits, last {n.windows.permits_days} days</div></div>
            <div><div class="v">{fmt(n.requests.total)}</div><div class="k">311 requests</div></div>
            <div><div class="v">{n.homes ? money(n.homes.house.median_12mo) : "—"}</div><div class="k">median house price</div></div>
          </div>
          <p class="note">Data as of {asOf(n.generated_at)}</p>
        </a>
      ))}
    </div>
  </main>
</Base>
