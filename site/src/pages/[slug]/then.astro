---
// "Then" was renamed "History" on 2026-11-02; old links forward to the new address.
import { staticPaths, pageUrl, type Neighborhood } from "../../lib/data";

export const getStaticPaths = staticPaths;
const { n } = Astro.props as { n: Neighborhood };
const to = pageUrl(n.slug, "history/");
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /><meta name="robots" content="noindex" /><title>{n.name} history</title></head>
<body><p><a href={to}>{n.name} history</a></p></body></html>
