---
// One page per hundred block (ingest/blocks.py): the practical lookups for that block, and whatever the
// neighborhood's records say happened on it. Nothing here is finer than the block, except permits and sales,
// which are public records tied to a property address.
import Hood from "../../../layouts/Hood.astro";
import { neighborhoods, pageUrl, type Block, type Neighborhood } from "../../../lib/data";
import { blockActivity } from "../../../lib/blocks";
import { streetLabel } from "../../../lib/atlas";
import { addr, money, shortDate, titleCase, fmt } from "../../../lib/c5";
import { reqTitle } from "../../../lib/front";
import { pickupFeed } from "../../../lib/ics";
import CalLink from "../../../components/CalLink.astro";

export function getStaticPaths() {
  return neighborhoods.flatMap((n) => (n.blocks?.items ?? []).map((b) => ({ params: { slug: n.slug, block: b.key }, props: { n, b } })));
}
const { n, b } = Astro.props as { n: Neighborhood; b: Block };
const u = (p: string) => pageUrl(n.slug, p);
const act = blockActivity(n, b.key);
const bl = n.blocks!;
const sch = (id?: string) => (id ? bl.schools[id] : undefined);
const smd = n.smds.find((s) => s.smd === b.smd);
const km = (lat: number, lon: number) => Math.hypot((lon - b.lon) * 111.32 * Math.cos((b.lat * Math.PI) / 180), (lat - b.lat) * 110.57);
const dist = (k: number) => (k < 0.04 ? "on this block" : k < 1 ? `${Math.round((k * 1000) / 10) * 10} m away` : `${k.toFixed(1)} km away`);
const nearest = <T extends { lat: number; lon: number }>(xs: T[] = []) => xs.map((x) => ({ x, d: km(x.lat, x.lon) })).sort((a, c) => a.d - c.d)[0];
const station = nearest(n.transit?.stations), stop = nearest(n.transit?.bus_stops), dock = nearest(n.transit?.bike_docks);
const sameStreet = bl.items.filter((x) => x.street === b.street).sort((a, c) => a.hundred - c.hundred);
const i = sameStreet.findIndex((x) => x.key === b.key);
const prev = sameStreet[i - 1], next = sameStreet[i + 1];
const short = (s: string) => s.replace(/ (NW|NE|SW|SE)$/, "");
const leafMsg = b.leaf_zone ? bl.leaf_status[b.leaf_zone] : null;
const sideWord: Record<string, string> = { N: "North side", S: "South side", E: "East side", W: "West side" };

// locator: streets within ~300 m, this block highlighted
const R = 0.0035;
const segs = bl.basemap.streets.filter((s) => s.p.some(([lo, la]) => Math.abs(lo - b.lon) < R * 1.3 && Math.abs(la - b.lat) < R));
const cos = Math.cos((b.lat * Math.PI) / 180);
const W = 360, H = 240, K = W / (2 * R * 1.3 * cos);
const P = (lo: number, la: number) => [((lo - b.lon) * cos * K + W / 2).toFixed(1), ((b.lat - la) * K + H / 2).toFixed(1)].join(",");
const d = (s: (typeof segs)[number]) => "M" + s.p.map(([lo, la]) => P(lo, la)).join(" L");
const title = `${b.name}, ${n.name}`;
const facts = [b.trash_day && `trash ${b.trash_day}`, b.schools.elementary && sch(b.schools.elementary)?.name && `zoned for ${sch(b.schools.elementary)!.name}`].filter(Boolean).join(", ");
---
<Hood n={n} page="blocks/" title={`${title}: trash day, schools, parking and what's happening`}
  description={`${b.name} in ${n.name}, Washington DC${facts ? `: ${facts}` : ""}. Recycling, leaf collection, parking zone, snow route, and recent permits, sales and 311 requests on the block.`}
  heading={b.name} intro={`${b.from && b.to ? `Between ${short(b.from)} and ${short(b.to)}, in` : "In"} ${n.name}.${b.smd ? ` Single-member district ${b.smd}.` : ""}`}>
  <div class="row even" style="margin-top:12px">
    <section class="panel" aria-labelledby="lk-h">
      <div class="ph"><h2 id="lk-h">On this block</h2><a href={u("blocks/")}>All blocks →</a></div>
      <table class="facts"><tbody>
        <tr><th scope="row">Trash pickup</th><td>{b.trash_day ?? "Not on DPW's route map"}<small>DPW residential collection</small>{pickupFeed(b.trash_day, b.recycling_day) && <CalLink slug={n.slug} feed={pickupFeed(b.trash_day, b.recycling_day)!} label="Pickup days in your calendar" />}</td></tr>
        <tr><th scope="row">Recycling pickup</th><td>{b.recycling_day ?? "Not on DPW's route map"}</td></tr>
        {b.leaf_zone && <tr><th scope="row">Leaf collection</th><td>{b.leaf_done ? "Done on this block this season" : "Not yet this season"}<small>Zone {b.leaf_zone}.{leafMsg && ` ${leafMsg}`}</small></td></tr>}
        <tr><th scope="row">Street sweeping</th><td>See the posted signs<small>DC doesn&rsquo;t publish a current block-by-block schedule; residential sweeping runs March to October.</small></td></tr>
        <tr><th scope="row">Snow emergency route</th><td>{b.snow_emergency ? "Yes: no parking once DC declares a snow emergency" : "No"}</td></tr>
        <tr><th scope="row">Parking</th><td>{b.parking.length === 0 ? "No parking inventory for this block" : b.parking.map((p) => <span style="display:block">{p.side ? `${sideWord[p.side] ?? p.side}: ` : ""}{p.rpp ? `Zone ${p.rpp} residential permit parking` : "No residential permit zone"}{p.meter && `; meters ${p.meter.replace(/ \$/, ", $").replace(/ (\d+)$/, ", $1-minute limit")}`}</span>)}</td></tr>
        {(["elementary", "middle", "high"] as const).map((lv) => {
          const s = sch(b.schools[lv]);
          return s && <tr><th scope="row">Zoned {lv} school</th><td>{s.url ? <a href={s.url}>{s.name}</a> : s.name}{s.address && <small>{s.address}{s.grades ? `, grades ${s.grades}` : ""}</small>}</td></tr>;
        })}
        {smd && <tr><th scope="row">ANC commissioner</th><td>{smd.commissioner ? titleCase(smd.commissioner) : "Vacant"}<small>{smd.smd}, ANC {smd.anc}{smd.url && <> · <a href={smd.url}>ANC site</a></>}</small></td></tr>}
        <tr><th scope="row">Speed limit</th><td>{b.speed ? `${b.speed} mph` : "Not recorded"}{(b.bike_lanes > 0 || b.bus_lane || b.slow_street) && <small>{[b.bike_lanes > 0 && (b.protected_bike_lane ? "protected bike lane" : "bike lane"), b.bus_lane && "bus lane", b.slow_street && "signed slow street"].filter(Boolean).join(", ")}</small>}</td></tr>
        {b.pavement && <tr><th scope="row">Pavement</th><td>{b.pavement}<small>DDOT condition rating{b.pavement_checked && `, inspected ${b.pavement_checked}`}</small></td></tr>}
        {station && <tr><th scope="row">Nearest Metro</th><td>{station.x.name}<small>{dist(station.d)} as the crow flies</small></td></tr>}
        {stop && <tr><th scope="row">Nearest bus stop</th><td>{stop.x.name}<small>Stop {stop.x.id}, {dist(stop.d)} · <a href={u("transit/")}>live arrivals</a></small></td></tr>}
        {dock && <tr><th scope="row">Nearest bikeshare</th><td>{dock.x.name}<small>{dist(dock.d)}</small></td></tr>}
      </tbody></table>
    </section>
    <div class="stack" style="display:grid;gap:28px;align-content:start">
      <section class="panel" aria-labelledby="map-h"><div class="ph"><h2 id="map-h">Where</h2></div>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Map of the ${b.name} and the streets around it`} style="width:100%;height:auto;background:var(--land);display:block">
          {segs.map((s) => <path d={d(s)} fill="none" stroke="#fff" stroke-width={s.k === "major" ? 7 : 4} stroke-linecap="round" />)}
          {segs.filter((s) => s.b === b.key).map((s) => <path d={d(s)} fill="none" stroke="var(--red)" stroke-width="6" stroke-linecap="round" />)}
        </svg>
        <p class="fine" style="font-family:var(--sans)">{[prev && <a href={u(`blocks/${prev.key}/`)}>← {prev.hundred || "Unit"} block</a>, next && <a href={u(`blocks/${next.key}/`)}>{next.hundred} block →</a>].filter(Boolean).map((x, k) => <>{k > 0 && " · "}{x}</>)} of {streetLabel(b.street)}</p>
      </section>
      <section class="panel" aria-labelledby="act-h"><div class="ph"><h2 id="act-h">What&rsquo;s happening here</h2></div>
        {act.permits.length + act.sales.length + act.requests.length + act.curb.length === 0 && <p class="note">Nothing recorded on this block in the last month: no building permits, recent sales, 311 requests or curb permits.</p>}
        {act.curb.length > 0 && <><h3 class="subh">Curb space reserved</h3><ul class="plainlist">{act.curb.map((c) => <li>{c.type}, {shortDate(c.start)}–{shortDate(c.end)}{c.hours && <span class="meta">{c.hours}</span>}</li>)}</ul></>}
        {act.permits.length > 0 && <><h3 class="subh">Building permits, last {n.windows.permits_days} days</h3><ul class="plainlist">{act.permits.map((p) => <li>{addr(p.address)}: {p.group.toLowerCase()} <span class="meta">{shortDate(p.issued)}</span></li>)}</ul></>}
        {act.sales.length > 0 && <><h3 class="subh">Recent sales</h3><ul class="plainlist">{act.sales.map((s) => <li>{s.address}, {money(s.price)} <span class="meta">{shortDate(s.date)}</span></li>)}</ul></>}
        {act.requests.length > 0 && <><h3 class="subh">311 requests, last {n.windows.requests_days} days</h3><ul class="plainlist">{act.requests.map((r) => <li>{reqTitle(r.type)} <span class="meta">{shortDate(r.added)} · {r.status.toLowerCase()}</span></li>)}</ul></>}
        {act.trees.length > 0 && <><h3 class="subh">Notable trees</h3><ul class="plainlist">{act.trees.map((t) => <li>{t.species}, {fmt(t.dbh_in)} in across</li>)}</ul></>}
      </section>
    </div>
  </div>
  <p class="fine" style="margin-top:24px;font-family:var(--sans)">Sources: {bl.sources.map((s, k) => <>{k > 0 && " · "}<a href={s.url}>{s.name}</a></>)}. Collection days and school zones are matched at the middle of the block; check the official source before relying on them.</p>
</Hood>
