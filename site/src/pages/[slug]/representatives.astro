---
import Hood from "../../layouts/Hood.astro";
import { staticPaths, pageUrl, type Neighborhood } from "../../lib/data";
import { titleCase, newsDate, eventDay } from "../../lib/c5";

export const getStaticPaths = staticPaths;
const { n } = Astro.props as { n: Neighborhood };
const u = (p: string) => pageUrl(n.slug, p);
const ancs = [...new Set(n.smds.map((s) => s.anc))].sort().map((anc) => {
  const rs = n.smds.filter((s) => s.anc === anc).sort((a, b) => a.smd.localeCompare(b.smd));
  return { anc, rs, url: rs.find((s) => s.url)?.url ?? null };
});
const vacant = n.smds.filter((s) => !s.commissioner).length;

// ---- ANC Decoder: what the commissions are doing, from their own posts and DC's ANC office ----
const TOPICS: [RegExp, string, string][] = [
  [/\bABRA\b|\bABCA\b|liquor|alcohol/i, "Liquor license", "A bar, restaurant or store's liquor license; the ANC can protest or set conditions."],
  [/\bBZA\b|zoning|variance|special exception/i, "Zoning case", "A request to build or use a property in a way zoning doesn't allow by right."],
  [/\bHPRB\b|historic/i, "Historic preservation", "Changes to a building in a historic district."],
  [/\bDDOT\b|traffic|pedestrian|bike|bus|parking|sidewalk|public space|streetery/i, "Streets & public space", "Traffic, parking, sidewalks and anything built in the public right of way."],
  [/grant/i, "Grant request", "ANCs can give small grants to local groups; each one is voted on."],
  [/budget|financial|treasurer/i, "ANC finances", "The commission's own budget and spending reports."],
  [/minutes/i, "Meeting minutes", "The official record of what was voted on."],
  [/agenda/i, "Meeting agenda", "What's on the next meeting's table."],
  [/crime|police|MPD/i, "Police report", "MPD's monthly report to the commission."],
  [/presentation|briefing|update from/i, "Presentation", "A DC agency, utility or developer briefing the commission."],
  [/resolution/i, "Resolution", "A formal position the ANC voted to send to a DC agency."],
];
const topic = (t: string) => TOPICS.find(([re]) => re.test(t)) ?? null;
const ancPosts = (n.news?.items ?? []).filter((i) => /^ANC /.test(i.source)).map((i) => ({ ...i, topic: topic(i.title) }));
const topicCounts = TOPICS.map(([, name, why]) => ({ name, why, n: ancPosts.filter((p) => p.topic?.[1] === name).length })).filter((t) => t.n);
const ev = n.events;
const upcoming = (ev?.events ?? []).filter((e) => e.kind === "civic");
const notices = (ev?.anc_meetings ?? []).filter((m) => !ev || m.date < ev.today).slice(0, 8);
const postAncs = new Set(ancPosts.map((p) => p.source));
const unread = ancs.filter((a) => !postAncs.has(`ANC ${a.anc}`));
---
<Hood n={n} page="representatives/" title={`Who represents ${n.name}: ANC commissioners and what's on their agenda`} description={`The Advisory Neighborhood Commissions and Single Member Districts that cover ${n.name}, with each commissioner and a plain-language guide to what an ANC does.`}
  heading="Representatives" intro={`${n.name} is covered by ${n.smds.length} Single Member Districts in ${ancs.length} Advisory Neighborhood Commission${ancs.length === 1 ? "" : "s"}. Each district elects one unpaid commissioner, your closest elected official.`}>

  <div class="row">
    <section id="smds" class="panel" aria-labelledby="sm-h">
      <div class="ph"><h2 id="sm-h">Your commissioners</h2><span class="sub">{n.smds.length} SMDs · {ancs.length} ANC{ancs.length === 1 ? "" : "s"}</span></div>
      <div class="stats s3 reps-st">
        <div><div class="v">{ancs.length}</div><div class="k">Advisory Neighborhood Commission{ancs.length === 1 ? "" : "s"}</div></div>
        <div><div class="v">{n.smds.length}</div><div class="k">Single Member Districts</div></div>
        <div><div class="v">{vacant}</div><div class="k">vacant seat{vacant === 1 ? "" : "s"}</div></div>
      </div>
      <div class="reps-grid">
        {ancs.map((a) => (
          <div class="anc reps-anc">
            <div class="anc-h"><span>ANC {a.anc} · {a.rs.length} SMD{a.rs.length === 1 ? "" : "s"}</span>{a.url && <a href={a.url}>ANC {a.anc} site ↗</a>}</div>
            <ul>{a.rs.map((s) => <li><span class="smd num">{s.smd}</span><span>{s.commissioner ? titleCase(s.commissioner) : <span class="reps-vac">Vacant</span>}</span></li>)}</ul>
          </div>
        ))}
      </div>
      <p class="repnote">Some of these districts may reach beyond the {n.name} boundary. Names of elected officials are public record.</p>
    </section>

    <div class="stack">
      <section class="panel" aria-labelledby="fd-h">
        <div class="ph"><h2 id="fd-h">Find your district</h2></div>
        <p class="reps-p">Your Single Member District depends on your exact address. DC's ANC office has a lookup that returns your district and commissioner.</p>
        <a class="cta" href="https://anc.dc.gov/">Look up your SMD by address <span>anc.dc.gov ↗</span></a>
      </section>
      <section class="panel" aria-labelledby="mt-h">
        <div class="ph"><h2 id="mt-h">Next ANC meetings</h2></div>
        {upcoming.length === 0 ? <p class="reps-p">No meeting notice posted yet for the next {ev?.days_ahead ?? 30} days. ANCs usually post a week or two ahead.</p> : (
          <ul class="rec">{upcoming.map((e) => <li><a href={e.url} rel="noopener">{e.title}</a><span>{eventDay(e.date, ev!.today).label}{e.time && ` · ${e.time}`}</span></li>)}</ul>
        )}
        <ul class="reps-links">
          {ancs.map((a) => <li>{a.url ? <a href={a.url}>ANC {a.anc} site ↗</a> : <span>ANC {a.anc}: no site on file; use anc.dc.gov</span>}</li>)}
        </ul>
      </section>
    </div>
  </div>

  <div class="row" id="decoder">
    <section class="panel" aria-labelledby="dec-h">
      <div class="ph"><h2 id="dec-h">ANC Decoder: what's on the table</h2><span class="sub">{ancPosts.length} posts · 6 months</span></div>
      {ancPosts.length === 0 ? <p class="note">None of {n.name}'s ANCs publishes its documents in a form we can read automatically, so there's nothing to decode yet. {unread.map((a) => `ANC ${a.anc}`).join(" and ")} {unread.length === 1 ? "posts" : "post"} on {unread.length === 1 ? "its" : "their"} own site{unread.length === 1 ? "" : "s"}; see the links beside this.</p> : (
        <ol class="hl">
          {ancPosts.slice(0, 14).map((p) => (
            <li><a href={p.url} rel="noopener">{p.title}</a>
              <span class="hl-m">{p.topic ? <span class="kind k-civic">{p.topic[1]}</span> : <span class="kind">Other</span>} <b>{p.source}</b> · {newsDate(p.published, n.generated_at)}</span></li>
          ))}
        </ol>
      )}
      {ancPosts.length > 0 && unread.length > 0 && <p class="hl-note">{unread.map((a) => `ANC ${a.anc}`).join(" and ")} {unread.length === 1 ? "doesn't" : "don't"} publish a feed we can read, so only {[...postAncs].join(" and ")} is decoded here.</p>}
    </section>
    <div class="stack">
      <section class="panel" aria-labelledby="tp-h">
        <div class="ph"><h2 id="tp-h">What the topics mean</h2></div>
        {topicCounts.length === 0 ? <p class="reps-p">Each post is tagged by topic once there are posts to read.</p> : (
          <ul class="rec">{topicCounts.map((t) => <li><b>{t.name} <span class="num">({t.n})</span></b><span>{t.why}</span></li>)}</ul>
        )}
      </section>
      <section class="panel" aria-labelledby="nt-h">
        <div class="ph"><h2 id="nt-h">Recent meeting notices</h2><span class="sub">DC Office of ANCs</span></div>
        {notices.length === 0 ? <p class="reps-p">DC's ANC office posts a notice for each public meeting, often with the recording. We started collecting them for {n.name}'s ANCs ({(ev?.ancs ?? ancs.map((a) => `ANC ${a.anc}`)).join(", ")}) on Oct 31, 2026; they'll collect here.</p> : (
          <ul class="rec">{notices.map((m) => <li><a href={m.url} rel="noopener">{m.title}</a></li>)}</ul>
        )}
      </section>
    </div>
  </div>

  <div class="row one">
    <section id="what" class="panel" aria-labelledby="wh-h">
      <div class="ph"><h2 id="wh-h">What an ANC does</h2></div>
      <div class="reps-cols">
        <div class="prose">
          <p>An Advisory Neighborhood Commission is the most local level of DC government. The city is split into ANCs, and each ANC into small Single Member Districts. Every district elects one commissioner. Commissioners are unpaid neighbors.</p>
          <p>ANCs don't make final decisions. They vote on positions and send them to DC agencies, which by law must give those positions <b>"great weight"</b>: the agency has to respond to the ANC's concerns in writing when it decides.</p>
        </div>
        <div>
          <div class="reps-sub">Where ANCs weigh in</div>
          <ul class="reps-topics">
            <li><b>Zoning</b><span>Variances, special exceptions and new development before the zoning boards</span></li>
            <li><b>Liquor licenses</b><span>New bars, restaurants and stores, and changes to their hours</span></li>
            <li><b>Public space</b><span>Sidewalk cafes, driveways, curb cuts and anything built in the public right of way</span></li>
            <li><b>Permits</b><span>Building, historic preservation and other city permits that affect the neighborhood</span></li>
          </ul>
        </div>
      </div>
      <a class="cta" href={u("projects/")}>See the permits issued in {n.name} this month <span>Projects →</span></a>
    </section>
  </div>
</Hood>

<style is:global>
  .reps-st{margin-bottom:16px}
  .reps-grid{display:grid;gap:14px}
  .reps-grid .anc+.anc{margin-top:0}
  .reps-anc{background:var(--surface-2);border:1px solid var(--line-2);border-radius:12px;padding:12px 14px 6px}
  .reps-anc .anc-h{gap:10px;flex-wrap:wrap}
  .reps-anc li:first-child{border-top:0}
  .reps-vac{color:var(--muted);font-style:italic}
  .reps-p{margin:0;font-size:14px;color:var(--ink-2)}
  .reps-links{list-style:none;margin:12px 0 0;padding:0;font-size:14px}
  .reps-links li{padding:7px 0;border-top:1px solid var(--line-2)}
  .reps-links a{text-decoration:none;font-weight:600}
  .reps-cols{display:grid;gap:18px}
  .reps-cols .prose p{margin:0 0 10px}
  .reps-sub{font:600 11px/1 var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}
  .reps-topics{list-style:none;margin:0;padding:0}
  .reps-topics li{display:grid;gap:2px;padding:9px 0;border-top:1px solid var(--line-2);font-size:14px}
  .reps-topics li:first-child{border-top:0}
  .reps-topics span{color:var(--muted);font-size:13px}
  @media (min-width:720px){
    .reps-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
    .reps-cols{grid-template-columns:1.2fr 1fr;gap:32px}
  }
</style>
