---
// The Jobs page was removed on 2026-11-02 (too few listings to be useful); old links land on the front page.
import { staticPaths, pageUrl, type Neighborhood } from "../../lib/data";

export const getStaticPaths = staticPaths;
const { n } = Astro.props as { n: Neighborhood };
const to = pageUrl(n.slug);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /><meta name="robots" content="noindex" /><title>{n.name}</title></head>
<body><p><a href={to}>{n.name}</a></p></body></html>
