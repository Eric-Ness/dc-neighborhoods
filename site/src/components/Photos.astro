---
// Historical photos (site/src/curated/photos.json): Library of Congress items marked "no known restrictions on
// publication", each placed in the neighborhood from the item's own title or notes. Images load from loc.gov and
// link to the Library's record; nothing is copied or re-hosted.
interface Photo { title: string; date: string | null; place: string; item: string; image: string; collection: string; rights: string }
interface Props { slug: string; name?: string }
const { slug } = Astro.props;
const files = import.meta.glob<{ default: { neighborhoods: Record<string, Photo[]> } }>("../curated/photos.json", { eager: true });
const photos = Object.values(files)[0]?.default.neighborhoods[slug] ?? [];
---
{photos.length > 0 && (
  <div class="row one">
    <section id="photos" class="panel" aria-labelledby="ph-h">
      <div class="ph"><h2 id="ph-h">Historical photos</h2><span class="sub">Library of Congress</span></div>
      <ul class="photos">
        {photos.map((p) => (
          <li>
            <a href={p.item} rel="noopener">
              <img src={p.image} alt={`${p.title}${p.date ? `, ${p.date}` : ""}`} loading="lazy" decoding="async" />
            </a>
            <div class="pc"><span class="pp">{p.place}</span>{p.date && <span class="pd"> · {p.date.replace(/^Documentation compiled /, "").replace(/\.$/, "")}</span>}
              <a class="pt" href={p.item} rel="noopener">{p.title}</a></div>
          </li>
        ))}
      </ul>
      <p class="note">Photographs from the Library of Congress ({[...new Set(photos.map((p) => p.collection))].join("; ")}), each with no known restrictions on publication or in the public domain, per the Library. Titles are the Library's, written when the photos were catalogued; some use the language of their time. Each links to its record.</p>
    </section>
  </div>
)}
