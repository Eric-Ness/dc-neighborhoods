---
// Live "next arrivals" board. The page lists this neighborhood's stations, stops and docks (ingest/transit.py);
// the browser asks our Worker (/api/transit) for live predictions at a few of them, and the Worker asks WMATA and
// Capital Bikeshare, caching each answer ~30 s. "Use my location" picks the nearest stops in the browser only:
// the location itself is never sent, just the stop ids.
import type { Neighborhood } from "../lib/data";

interface Props { n: Neighborhood; compact?: boolean }
const { n, compact = false } = Astro.props;
const t = n.transit;
const stations = (t?.stations ?? []).slice(0, compact ? 1 : 3);
// Default anchor: the nearest Metro station if it is inside the neighborhood, else the middle of the boundary.
const ring = n.boundary.rings[0] ?? [];
const mid = ring.length ? [ring.reduce((a, p) => a + p[0], 0) / ring.length, ring.reduce((a, p) => a + p[1], 0) / ring.length] : [0, 0];
const anchor = stations[0] && stations[0].km_outside === 0 ? [stations[0].lon, stations[0].lat] : mid;
const cfg = {
  stations: stations.map((s) => ({ name: s.name, lines: s.lines })),
  stops: t?.bus_stops ?? [],
  docks: t?.bike_docks ?? [],
  anchor,
  nStops: compact ? 3 : 6,
  nDocks: compact ? 3 : 6,
};
---
{!t ? <p class="empty">Transit stops didn&rsquo;t update tonight.</p> : (
  <div class="board" data-cfg={JSON.stringify(cfg)} aria-live="polite">
    {stations.map((s) => (
      <div class="stn" data-station={s.name}>
        <h3>{s.lines.map((l) => <span class={`ln ln-${l}`} title={`${l} line`}></span>)} {s.name}{s.km_outside > 0 && <span class="muted">{s.km_outside < 1 ? `${Math.round(s.km_outside * 1000)} m` : `${s.km_outside} km`} outside</span>}</h3>
        <ul class="rail"><li><span class="muted">Loading live trains…</span><b></b></li></ul>
      </div>
    ))}
    <p class="bus-h">Buses <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:400" data-where>near {stations[0]?.km_outside === 0 ? stations[0].name : `the middle of ${n.name}`}</span></p>
    <div class="buses"><p class="muted">Loading live buses…</p></div>
    <p class="bus-h">Capital Bikeshare</p>
    <ul class="bikes"><li><span class="muted">Loading docks…</span><b></b></li></ul>
    <button type="button" class="near">Use my location</button>
    <p class="note" data-status>Arrival times are WMATA&rsquo;s predictions and refresh every 30 seconds. Not affiliated with WMATA or Capital Bikeshare.</p>
  </div>
)}

<script>
  type Stop = { id: string; name: string; lat: number; lon: number };
  type Cfg = { stations: { name: string; lines: string[] }[]; stops: Stop[]; docks: Stop[]; anchor: [number, number]; nStops: number; nDocks: number };
  type Live = {
    rail?: { station: string; trains: { line: string; dest: string; min: string }[] }[] | null;
    bus?: { stop: string; preds: { route: string; dir: string; min: number }[] }[] | null;
    bikes?: { id: string; bikes: number; ebikes: number; docks: number; renting: boolean }[] | null;
    alerts?: string[];
    note?: string;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const LINE: Record<string, string> = { RD: "red", OR: "orange", SV: "silver", BL: "blue", YL: "yellow", GR: "green" };

  for (const el of document.querySelectorAll<HTMLElement>(".board[data-cfg]")) {
    const cfg: Cfg = JSON.parse(el.dataset.cfg!);
    let at: [number, number] = cfg.anchor;
    const near = <T extends Stop>(list: T[], k: number) =>
      [...list].sort((a, b) => Math.hypot(a.lon - at[0], a.lat - at[1]) - Math.hypot(b.lon - at[0], b.lat - at[1])).slice(0, k);
    const status = el.querySelector<HTMLElement>("[data-status]")!;
    const baseNote = status.innerHTML;

    async function refresh() {
      const stops = near(cfg.stops, cfg.nStops), docks = near(cfg.docks, cfg.nDocks);
      const q = new URLSearchParams({
        rail: cfg.stations.map((s) => s.name).join("|"),
        stops: stops.map((s) => s.id).join(","),
        docks: docks.map((d) => d.id).join(","),
      });
      let live: Live;
      try {
        const r = await fetch(`/api/transit?${q}`, { headers: { accept: "application/json" } });
        if (!r.ok) throw new Error(String(r.status));
        live = await r.json();
      } catch {
        live = { rail: null, bus: null, bikes: null, note: "Live arrivals aren't available right now." };
      }
      // trains
      for (const box of el.querySelectorAll<HTMLElement>(".stn")) {
        const ul = box.querySelector("ul")!;
        const st = live.rail?.find((x) => x.station === box.dataset.station);
        ul.innerHTML = !live.rail ? `<li><span class="muted">Live trains unavailable. <a href="https://www.wmata.com/schedules/next-arrival/">WMATA next arrivals</a></span><b></b></li>`
          : !st || st.trains.length === 0 ? `<li><span class="muted">No trains predicted right now</span><b></b></li>`
          : st.trains.slice(0, 6).map((t) => `<li><span><span class="ln ln-${LINE[t.line] ?? "none"}"></span> ${esc(t.dest)}</span><b>${t.min === "ARR" ? "Arriving" : t.min === "BRD" ? "Boarding" : t.min ? `${esc(t.min)} min` : "—"}</b></li>`).join("");
      }
      // buses
      const bus = el.querySelector<HTMLElement>(".buses")!;
      bus.innerHTML = !live.bus ? `<p class="muted">Live buses unavailable. <a href="https://www.wmata.com/schedules/next-arrival/">WMATA next arrivals</a></p>`
        : stops.map((s) => {
            const p = live.bus!.find((x) => x.stop === s.id);
            const rows = !p || p.preds.length === 0 ? `<li><span class="muted">No buses predicted in the next hour</span><b></b></li>`
              : p.preds.slice(0, 4).map((x) => `<li><span><span class="rt">${esc(x.route)}</span>${esc(x.dir)}</span><b>${x.min <= 0 ? "Due" : `${x.min} min`}</b></li>`).join("");
            return `<div class="stn"><h3>${esc(s.name)}</h3><ul>${rows}</ul></div>`;
          }).join("");
      // bikes
      const bikes = el.querySelector<HTMLElement>(".bikes")!;
      bikes.innerHTML = !live.bikes ? `<li><span class="muted">Dock status unavailable</span><b></b></li>`
        : docks.map((d) => {
            const s = live.bikes!.find((x) => x.id === d.id);
            return `<li><span>${esc(d.name)}</span><span>${!s ? "—" : !s.renting ? "Not renting" : `<b>${s.bikes}</b> bikes${s.ebikes ? ` (${s.ebikes} e)` : ""} · ${s.docks} docks`}</span></li>`;
          }).join("");
      status.innerHTML = (live.alerts?.length ? `<strong>Metro alert:</strong> ${live.alerts.map(esc).join(" ")} ` : "") + (live.note ? esc(live.note) + " " : "") + baseNote;
    }

    let timer: ReturnType<typeof setInterval> | undefined;
    const start = () => { refresh(); clearInterval(timer); timer = setInterval(() => { if (!document.hidden) refresh(); }, 30_000); };
    // Only fetch once the board is on screen.
    new IntersectionObserver((es, ob) => { if (es.some((e) => e.isIntersecting)) { ob.disconnect(); start(); } }).observe(el);

    el.querySelector<HTMLButtonElement>("button.near")?.addEventListener("click", (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      if (!navigator.geolocation) { b.textContent = "Location not available"; return; }
      b.textContent = "Finding you…";
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          at = [pos.coords.longitude, pos.coords.latitude];
          b.textContent = "Using your location";
          const w = el.querySelector<HTMLElement>("[data-where]");
          if (w) w.textContent = "nearest you";
          start();
        },
        () => { b.textContent = "Location not shared"; },
        { maximumAge: 60_000, timeout: 10_000 },
      );
    });
  }
</script>
