---
import "../styles/fonts.css"; // self-hosted, so pages load nothing from Google
import "../styles/c5.css";
import "../styles/atlas-base.css";
import "../styles/atlas.css";
// Live neighborhoods only (ingest writes this list); each links to its own .org.
import sites from "../data/index.json";

interface Props {
  title: string;
  description: string;
  rss?: string;
  generated?: string;
  slug?: string; // the neighborhood this page belongs to, marked in the cross-site links
}
const { title, description, rss, generated, slug } = Astro.props;
const byName = [...sites].sort((x, y) => x.name.localeCompare(y.name));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {rss && <link rel="alternate" type="application/rss+xml" title={`${title}: new permits`} href={rss} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='4' fill='%234a5b67'/><path d='M4 12V4h4.5a2.5 2.5 0 0 1 0 5H4' stroke='white' fill='none' stroke-width='1.8'/></svg>" />
  </head>
  <body id="top">
    <slot />
    <footer><div class="wrap">
      <nav class="sites" aria-label="Other DC neighborhood sites">
        <span>DC neighborhood sites</span>
        <ul>{byName.map((x) => (
          <li>{x.slug === slug ? <span aria-current="page">{x.name}</span> : <a href={`https://${x.hosts[0]}/`}>{x.name} <small>{x.hosts[0]}</small></a>}</li>
        ))}</ul>
      </nav>
      <p><strong>An independent project. Not affiliated with the DC Government, any Advisory Neighborhood Commission, or any Business Improvement District.</strong></p>
      <p>Data comes from Open Data DC (CC BY 4.0) and the Library of Congress, shown as published; it may lag or contain errors. Headlines and events link to whoever published them. Crime figures are preliminary counts. Check the official source before acting on anything here.</p>
      <slot name="footer" />
    </div></footer>
    <a href="#top" class="totop" aria-label="Back to top"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></a>
    <script is:inline>
      // The button waits until there is somewhere to go back from. Without JS it stays visible and the link still works.
      (function () {
        var top = document.querySelector(".totop");
        var show = function () { top.hidden = window.scrollY < 600; };
        show();
        window.addEventListener("scroll", show, { passive: true });
        top.addEventListener("click", function (e) {
          e.preventDefault();
          var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
        });
      })();
    </script>
    <script is:inline>
      // Long tables marked data-collapse="N" show N rows plus a "Show all" button. Without JS, every row shows.
      document.querySelectorAll("table[data-collapse]").forEach(function (t) {
        var n = +t.dataset.collapse, rows = t.tBodies[0] ? t.tBodies[0].rows : [];
        if (rows.length <= n + 2) return; // not worth hiding one or two rows
        for (var i = n; i < rows.length; i++) rows[i].hidden = true;
        var b = document.createElement("button");
        b.type = "button"; b.className = "more-btn";
        var label = "Show all " + rows.length + " " + (t.dataset.noun || "rows");
        b.textContent = label; b.setAttribute("aria-expanded", "false");
        b.addEventListener("click", function () {
          var open = b.getAttribute("aria-expanded") !== "true";
          for (var i = n; i < rows.length; i++) rows[i].hidden = !open;
          b.setAttribute("aria-expanded", String(open));
          b.textContent = open ? "Show fewer" : label;
          if (!open) t.scrollIntoView({ block: "nearest" });
        });
        (t.closest(".dtable-wrap") || t).after(b);
      });
    </script>
    {generated && (
      // The build can't know when someone visits, so the staleness warning is decided in the browser.
      // The time rides on a data attribute so this script is the same on every page: the Worker's
      // Content-Security-Policy allows inline scripts only by their hash (tools/csp-hashes.mjs).
      <script is:inline data-generated={generated}>
        (function () { var g = document.currentScript.dataset.generated;
          if (Date.now() - Date.parse(g) > 3 * 86400000) { var s = document.getElementById("stale"); if (s) s.hidden = false; } })();
      </script>
    )}
  </body>
</html>
