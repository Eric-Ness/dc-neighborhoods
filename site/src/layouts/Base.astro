---
interface Props {
  title: string;
  description: string;
  rss?: string;
}
const { title, description, rss } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {rss && <link rel="alternate" type="application/rss+xml" title={`${title}: new permits`} href={rss} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%23245c4f'/><path d='M4 11V5h3l2 3 2-3v6' stroke='white' fill='none' stroke-width='1.6'/></svg>" />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          <strong>Independent project.</strong> Not affiliated with the DC Government, any Advisory Neighborhood
          Commission, or any Business Improvement District. Data comes from Open Data DC (CC BY 4.0) and is shown as
          published; it may lag or contain errors. Follow the official source before acting on anything here.
        </p>
        <slot name="footer" />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --surface: #ffffff;
    --ink: #1d2321;
    --muted: #5d6763;
    --line: #e3e0d8;
    --accent: #245c4f;
    --accent-soft: #e4efeb;
    --up: #a33a2c;
    --down: #2c6e49;
    --dot: #c4572f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141816;
      --surface: #1c211f;
      --ink: #e8ece9;
      --muted: #9aa5a0;
      --line: #2e3532;
      --accent: #7cc4ad;
      --accent-soft: #22312c;
      --up: #f08a7a;
      --down: #8fd3a8;
      --dot: #f29a6f;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.2; }
  h2 { margin-top: 2.2rem; font-size: 1.3rem; }
  .muted { color: var(--muted); }
  .site-footer { margin-top: 3rem; border-top: 1px solid var(--line); padding: 1.5rem 0 3rem; font-size: 0.9rem; color: var(--muted); }
  .disclaimer strong { color: var(--ink); }
  table { width: 100%; border-collapse: collapse; font-size: 0.93rem; }
  th, td { text-align: left; padding: 0.45rem 0.5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-weight: 600; color: var(--muted); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.03em; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.1rem; }
  .scroll-x { overflow-x: auto; }
</style>
