---
import "../styles/c5.css";

interface Props {
  title: string;
  description: string;
  rss?: string;
  generated?: string;
}
const { title, description, rss, generated } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {rss && <link rel="alternate" type="application/rss+xml" title={`${title}: new permits`} href={rss} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='4' fill='%23466f60'/><path d='M4 12V4h4.5a2.5 2.5 0 0 1 0 5H4' stroke='white' fill='none' stroke-width='1.8'/></svg>" />
  </head>
  <body>
    <slot />
    <footer><div class="wrap">
      <p><strong>Independent project. Not affiliated with the DC Government, any Advisory Neighborhood Commission, or any Business Improvement District.</strong></p>
      <p>Data comes from Open Data DC (CC BY 4.0) and the Library of Congress, shown as published; it may lag or contain errors. Crime figures are preliminary counts. Check the official source before acting on anything here.</p>
      <slot name="footer" />
    </div></footer>
    {generated && (
      <script is:inline define:vars={{ generated }}>
        // The build can't know when someone visits, so the staleness warning is decided in the browser.
        if (Date.now() - Date.parse(generated) > 3 * 86400000) { var s = document.getElementById("stale"); if (s) s.hidden = false; }
      </script>
    )}
  </body>
</html>
