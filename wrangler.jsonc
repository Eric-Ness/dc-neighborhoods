{
  // One Worker serves every neighborhood domain from one static build (site/dist).
  // Each domain must be a zone in your Cloudflare account before deploying.
  "name": "dc-neighborhoods",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "petworth.org", "custom_domain": true },
    { "pattern": "www.petworth.org", "custom_domain": true },
    { "pattern": "tenleytown.org", "custom_domain": true },
    { "pattern": "www.tenleytown.org", "custom_domain": true },
    { "pattern": "adamsmorgan.org", "custom_domain": true },
    { "pattern": "www.adamsmorgan.org", "custom_domain": true },
    { "pattern": "friendshipheights.org", "custom_domain": true },
    { "pattern": "www.friendshipheights.org", "custom_domain": true },
    { "pattern": "capitolhilldc.org", "custom_domain": true },
    { "pattern": "www.capitolhilldc.org", "custom_domain": true },
    { "pattern": "columbiaheights.net", "custom_domain": true },
    { "pattern": "www.columbiaheights.net", "custom_domain": true },
    { "pattern": "georgetowndc.org", "custom_domain": true },
    { "pattern": "www.georgetowndc.org", "custom_domain": true },
    { "pattern": "chevychasedc.net", "custom_domain": true },
    { "pattern": "www.chevychasedc.net", "custom_domain": true },
    { "pattern": "anacostiadc.net", "custom_domain": true },
    { "pattern": "www.anacostiadc.net", "custom_domain": true },
    { "pattern": "clevelandpark.org", "custom_domain": true },
    { "pattern": "www.clevelandpark.org", "custom_domain": true },
    { "pattern": "dupontcircledc.net", "custom_domain": true },
    { "pattern": "www.dupontcircledc.net", "custom_domain": true },
    { "pattern": "hstreet.net", "custom_domain": true },
    { "pattern": "www.hstreet.net", "custom_domain": true },
    { "pattern": "navyyarddc.net", "custom_domain": true },
    { "pattern": "www.navyyarddc.net", "custom_domain": true },
    { "pattern": "brooklanddc.org", "custom_domain": true },
    { "pattern": "www.brooklanddc.org", "custom_domain": true },
    { "pattern": "gloverpark.net", "custom_domain": true },
    { "pattern": "www.gloverpark.net", "custom_domain": true },
    { "pattern": "lenfantplaza.org", "custom_domain": true },
    { "pattern": "www.lenfantplaza.org", "custom_domain": true },
    { "pattern": "nomadc.net", "custom_domain": true },
    { "pattern": "www.nomadc.net", "custom_domain": true },
    { "pattern": "palisadesdc.net", "custom_domain": true },
    { "pattern": "www.palisadesdc.net", "custom_domain": true }
    // chinatown-dc.org, shawdc.org, logancircledc.org, ustreet.org and vannessdc.org (and lenfantplaza.net, which redirects
    // to the .org) come back once their zones are active on Cloudflare; their sites are disabled in neighborhoods.json until then.
    // capitolriverfront.net (redirects to navyyarddc.net) comes back once its zone is active on Cloudflare.
    // petworth.net and tenleytown.net come back here once those zones are on Cloudflare;
    // the Worker already 301s them to the .org.
  ]
}
