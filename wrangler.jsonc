{
  // One Worker serves every neighborhood domain from one static build (site/dist).
  // Each domain must be a zone in your Cloudflare account before deploying.
  "name": "dc-neighborhoods",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "petworth.org", "custom_domain": true },
    { "pattern": "www.petworth.org", "custom_domain": true },
    { "pattern": "tenleytown.org", "custom_domain": true },
    { "pattern": "www.tenleytown.org", "custom_domain": true },
    { "pattern": "adamsmorgan.org", "custom_domain": true },
    { "pattern": "www.adamsmorgan.org", "custom_domain": true },
    { "pattern": "friendshipheights.org", "custom_domain": true },
    { "pattern": "www.friendshipheights.org", "custom_domain": true },
    { "pattern": "capitolhilldc.org", "custom_domain": true },
    { "pattern": "www.capitolhilldc.org", "custom_domain": true },
    { "pattern": "columbiaheights.net", "custom_domain": true },
    { "pattern": "www.columbiaheights.net", "custom_domain": true },
    { "pattern": "georgetowndc.org", "custom_domain": true },
    { "pattern": "www.georgetowndc.org", "custom_domain": true },
    { "pattern": "chevychasedc.net", "custom_domain": true },
    { "pattern": "www.chevychasedc.net", "custom_domain": true },
    { "pattern": "anacostiadc.net", "custom_domain": true },
    { "pattern": "www.anacostiadc.net", "custom_domain": true },
    { "pattern": "clevelandpark.org", "custom_domain": true },
    { "pattern": "www.clevelandpark.org", "custom_domain": true },
    { "pattern": "dupontcircledc.net", "custom_domain": true },
    { "pattern": "www.dupontcircledc.net", "custom_domain": true },
    { "pattern": "hstreet.net", "custom_domain": true },
    { "pattern": "www.hstreet.net", "custom_domain": true },
    { "pattern": "navyyarddc.net", "custom_domain": true },
    { "pattern": "www.navyyarddc.net", "custom_domain": true },
    { "pattern": "brooklanddc.org", "custom_domain": true },
    { "pattern": "www.brooklanddc.org", "custom_domain": true },
    { "pattern": "gloverpark.net", "custom_domain": true },
    { "pattern": "www.gloverpark.net", "custom_domain": true },
    { "pattern": "lenfantplaza.org", "custom_domain": true },
    { "pattern": "www.lenfantplaza.org", "custom_domain": true },
    { "pattern": "nomadc.net", "custom_domain": true },
    { "pattern": "www.nomadc.net", "custom_domain": true },
    { "pattern": "palisadesdc.net", "custom_domain": true },
    { "pattern": "www.palisadesdc.net", "custom_domain": true },
    { "pattern": "chinatown-dc.org", "custom_domain": true },
    { "pattern": "www.chinatown-dc.org", "custom_domain": true },
    { "pattern": "shawdc.org", "custom_domain": true },
    { "pattern": "www.shawdc.org", "custom_domain": true },
    { "pattern": "logancircledc.org", "custom_domain": true },
    { "pattern": "www.logancircledc.org", "custom_domain": true },
    { "pattern": "ustreet.org", "custom_domain": true },
    { "pattern": "www.ustreet.org", "custom_domain": true },
    { "pattern": "vannessdc.org", "custom_domain": true },
    { "pattern": "www.vannessdc.org", "custom_domain": true },
    { "pattern": "bloomingdaledc.net", "custom_domain": true },
    { "pattern": "www.bloomingdaledc.net", "custom_domain": true },
    { "pattern": "foggybottom.net", "custom_domain": true },
    { "pattern": "www.foggybottom.net", "custom_domain": true },
    { "pattern": "hilleastdc.org", "custom_domain": true },
    { "pattern": "www.hilleastdc.org", "custom_domain": true },
    { "pattern": "kingmanpark.net", "custom_domain": true },
    { "pattern": "www.kingmanpark.net", "custom_domain": true },
    { "pattern": "mountpleasantdc.net", "custom_domain": true },
    { "pattern": "www.mountpleasantdc.net", "custom_domain": true },
    { "pattern": "stadiumarmory.org", "custom_domain": true },
    { "pattern": "www.stadiumarmory.org", "custom_domain": true },
    { "pattern": "trinidaddc.org", "custom_domain": true },
    { "pattern": "www.trinidaddc.org", "custom_domain": true },
    { "pattern": "woodleypark.net", "custom_domain": true },
    { "pattern": "www.woodleypark.net", "custom_domain": true },
    { "pattern": "brightwooddc.net", "custom_domain": true },
    { "pattern": "www.brightwooddc.net", "custom_domain": true },
    { "pattern": "congressheights.org", "custom_domain": true },
    { "pattern": "www.congressheights.org", "custom_domain": true },
    { "pattern": "takomadc.org", "custom_domain": true },
    { "pattern": "www.takomadc.org", "custom_domain": true },
    { "pattern": "deanwooddc.net", "custom_domain": true },
    { "pattern": "www.deanwooddc.net", "custom_domain": true },
    { "pattern": "hillcrestdc.org", "custom_domain": true },
    { "pattern": "www.hillcrestdc.org", "custom_domain": true },
    { "pattern": "bellevuedc.org", "custom_domain": true },
    { "pattern": "www.bellevuedc.org", "custom_domain": true },
    { "pattern": "16thstreetheights.org", "custom_domain": true },
    { "pattern": "www.16thstreetheights.org", "custom_domain": true }
    // lenfantplaza.net (redirects to the .org) comes back once its zone is active on Cloudflare.
    // capitolriverfront.net (redirects to navyyarddc.net) comes back once its zone is active on Cloudflare.
    // petworth.net and tenleytown.net come back here once those zones are on Cloudflare;
    // the Worker already 301s them to the .org.
    // bellevuedc.net (redirects to bellevuedc.org), twiningdc.org and fortlincoln.net come back here once their
    // zones are active on Cloudflare; Twining and Fort Lincoln are configured in neighborhoods.json but disabled.
  ]
}
